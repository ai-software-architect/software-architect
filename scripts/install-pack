#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-}"
TARGET_DIR="${2:-.}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [[ -z "$MODE" ]]; then
  echo "Usage: ./scripts/install-pack <greenfield|brownfield-adaptive> [target-dir]"
  exit 1
fi

"$ROOT_DIR/agents/codex/install/install.sh" "$MODE" "$TARGET_DIR"
