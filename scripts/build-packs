#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

mkdir -p "$ROOT_DIR/dist/codex/greenfield-java-spring-hexagonal"
mkdir -p "$ROOT_DIR/dist/codex/brownfield-java-spring-hexagonal"

cat   "$ROOT_DIR/agents/codex/base/AGENTS.md"   "$ROOT_DIR/agents/codex/overlays/greenfield.md"   "$ROOT_DIR/agents/codex/overlays/java-spring-hexagonal.md"   > "$ROOT_DIR/dist/codex/greenfield-java-spring-hexagonal/AGENTS.md"

cat   "$ROOT_DIR/agents/codex/base/AGENTS.md"   "$ROOT_DIR/agents/codex/overlays/brownfield-adaptive.md"   "$ROOT_DIR/agents/codex/overlays/java-spring-hexagonal.md"   > "$ROOT_DIR/dist/codex/brownfield-java-spring-hexagonal/AGENTS.md"

mkdir -p "$ROOT_DIR/dist/codex/greenfield-java-spring-hexagonal/skill"
mkdir -p "$ROOT_DIR/dist/codex/brownfield-java-spring-hexagonal/skill"

cp "$ROOT_DIR/agents/codex/base/skill/SKILL.md" "$ROOT_DIR/dist/codex/greenfield-java-spring-hexagonal/skill/SKILL.md"
cp "$ROOT_DIR/agents/codex/base/skill/SKILL.md" "$ROOT_DIR/dist/codex/brownfield-java-spring-hexagonal/skill/SKILL.md"

echo "Built Codex distributions in dist/codex"
